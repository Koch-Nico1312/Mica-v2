FROM python:3.12-slim
WORKDIR /app
COPY services/tts_service.py /app/tts_service.py
RUN pip install --no-cache-dir \
    fastapi "uvicorn[standard]" httpx==0.28.1 piper-tts==1.4.2 kokoro==0.9.4 soundfile==0.14.0
EXPOSE 8092
ENTRYPOINT []
CMD ["python", "-m", "uvicorn", "tts_service:app", "--host", "0.0.0.0", "--port", "8092"]
