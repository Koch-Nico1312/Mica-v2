FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
ENV HOME=/opt/mica
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
# Laya is opt-in because its CPU runtime and checkpoints are large. When the
# feature is enabled, bake both checkpoints used by MICA into the image so the
# internal-only runtime network never needs outbound access on first use.
ARG MICA_INSTALL_LAYA=0
RUN case "${MICA_INSTALL_LAYA}" in \
      1|true|yes|on) \
        pip install --no-cache-dir "laya==0.3.20" && \
        python -c "from huggingface_hub import snapshot_download; patterns=['rl_agent_config.json','model.safetensors','tokenizer/*','encoder/*','multilingual/rl_agent_config.json','multilingual/model.safetensors','multilingual/tokenizer/*','multilingual/encoder/*']; snapshot_download('convaiinnovations/laya', allow_patterns=patterns, local_dir='/opt/mica/laya-model')" \
        ;; \
    esac
RUN mkdir -p /opt/mica && python -c "from tree_sitter_language_pack import download_all; download_all()" && chown -R 65532:65532 /opt/mica
COPY services /app/services
COPY web_ui /app/web_ui
ENV PYTHONPATH=/app
USER 65532:65532
