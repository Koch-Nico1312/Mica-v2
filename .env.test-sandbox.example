# Keep 127.0.0.1 when SSH is reached through a VPN or an SSH tunnel.
# For direct LAN access, use the server's exact LAN address, never 0.0.0.0.
MICA_TEST_BIND_ADDRESS=127.0.0.1
MICA_TEST_SSH_PORT=2222

# The source is visible but read-only. /work is the only persistent writable area.
MICA_TEST_SOURCE_DIR=.
MICA_TEST_AUTHORIZED_KEYS=./.sandbox/authorized_keys

MICA_TEST_MEMORY_LIMIT=4g
MICA_TEST_CPUS=2.0
