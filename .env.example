# MICA V2 Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM Provider: ollama, openai, openai_api, gemini
# Default: ollama (local-first)
MICA_LLM_PROVIDER=ollama

# Local LLM Server URL (for ollama or openai-compatible)
MICA_LLM_URL=http://localhost:11434

# Local LLM Model Name
MICA_LLM_MODEL=llama3.2

# ============================================================================
# Gemini API Configuration (Cloud)
# ============================================================================

# Gemini API Key - Get from https://ai.google.dev
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model Name
MICA_GEMINI_MODEL=gemini-2.5-flash

# Alternative: GOOGLE_API_KEY (also accepted)
GOOGLE_API_KEY=your-gemini-api-key-here

# ============================================================================
# OpenAI API Configuration (Cloud)
# ============================================================================

# OpenAI API Key - Get from https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model Name
MICA_OPENAI_MODEL=gpt-4.1-mini

# ============================================================================
# Assistant Configuration
# ============================================================================

# Assistant Name (what the AI calls itself)
ASSISTANT_NAME=JARVIS

# User Name (what the AI calls you)
USER_NAME=Your Name

# ============================================================================
# Advanced Agent Configuration
# ============================================================================

# Code Agent: Allowed project roots (comma-separated paths)
CODE_AGENT_ALLOWED_ROOTS=/home/user/Desktop/JarvisProjects,/home/user/Projects,/home/user/code

# Model Router: Hourly budget limit in USD
MODEL_ROUTER_BUDGET_HOURLY=1.0

# Plugin Loader: Maximum memory per plugin in MB
PLUGIN_MAX_MEMORY_MB=512

# Plugin Loader: Execution timeout in seconds
PLUGIN_TIMEOUT_SECONDS=30

# ============================================================================
# Optional: Cloud Settings
# ============================================================================

# Allow private context data to be sent to cloud LLMs
# Set to "true" or "1" to enable (default: false)
MICA_CLOUD_ALLOW_PRIVATE_CONTEXT=false

# ============================================================================
# Optional: Development Settings
# ============================================================================

# Debug mode (set to "true" for verbose logging)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================
# - API keys are sensitive - never commit .env to version control
# - Use .env.example as a template for new installations
# - Local LLM (Ollama) is recommended for privacy and cost
# - Cloud LLMs provide advanced features but require API keys
# - Configure allowed project roots for Code Agent security