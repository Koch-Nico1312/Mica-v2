# MICA V2 desktop settings. Copy to .env; backend Compose uses backend/.env.example.
# Provider credentials belong in Windows Credential Manager.
MICA_CORE_URL=https://mica.local
# Store the matching MICA_API_TOKEN in Windows Credential Manager.
# See docs/api-access.md; never put it in this tracked example.
# MICA_CORE_CA_FILE=C:/path/to/caddy-local-root.crt

# Dream-RSI (Recursive Self-Improvement) — alles standardmäßig AUS
# Aktiviert den Meta-Loop: Entdeckungsbäume aufzeichnen, Policies im Replay
# bewerten, beste Policy als config-Artefakt vorschlagen (Promotion bleibt
# manuell freigabepflichtig).
MICA_DREAM_RSI_ENABLED=0
# Pfad der Discovery-Tree-Datenbank (Compose: /data/dream.sqlite3)
#MICA_DREAM_DB=/data/dream.sqlite3

# Optionaler lokaler Scorer für Brain-Reranking, Dream-RSI und Signal-Triage.
# Im Backend MICA_LAYA_ENABLED=1 in backend/.env setzen und das Compose-Image
# neu bauen; Paket und Checkpoint werden dann in das Image aufgenommen.
# Bei Fehlern oder fehlender Konfidenz nutzt MICA weiter das bisherige Ranking
# bzw. die deterministische Heuristik. Siehe docs/dream-rsi.md.
MICA_LAYA_ENABLED=0
# Mindestkonfidenz für Choice/Score-Ergebnisse; darunter nutzt MICA unverändert
# die vorhandene deterministische Reihenfolge bzw. Heuristik.
MICA_LAYA_MIN_CONFIDENCE=0.40
# Laya darf den deterministischen Dream-Replay-Score nur schwach beeinflussen.
MICA_LAYA_RERANK_WEIGHT=0.15
# Noul-Wahrscheinlichkeit ab der ein Vorschlag nur zur Prüfung erstellt werden darf.
MICA_LAYA_PROPOSAL_THRESHOLD=0.65

# Scrapling (adaptives Web-Scraping) für Recherche/Monitoring. Standardmäßig
# aktiv, WENN das Paket installiert ist; mit 0 erzwingt du die alten Parser.
# MICA_SCRAPLING_ENABLED=1

# Cua Driver (native App-Steuerung ohne Fokus-Klau). Benötigt den einmalig
# manuell installierten Windows-Driver (irm https://cua.ai/driver/install.ps1 | iex).
MICA_CUA_ENABLED=0

# OpenSEO via MCP (Keyword-Recherche, Rank-Tracking, Site-Audit). Benötigt
# eine OpenSEO-URL (self-hosted Docker oder https://openseo.so) und einen
# DataForSEO-Key im OS-Keyring (Tool seo_agent workflow=set_key).
MICA_OPENSEO_ENABLED=0
#MICA_OPENSEO_URL=https://openseo.so
#Tägliche Obergrenze bezahlter DataForSEO-Requests
MICA_OPENSEO_DAILY_BUDGET=20
#MICA_OPENSEO_DB=<Installationswurzel>/connectors.sqlite3 (Standard)

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM Provider: ollama, openai, openai_api, gemini
# Default: ollama (local-first)
MICA_LLM_PROVIDER=ollama

# Direct desktop LLM fallback URL (used by desktop/core/llm_client.py).
# Normal conversation uses the HTTPS Core API above.
MICA_LLM_URL=http://localhost:11434

# Local LLM Model Name
MICA_LLM_MODEL=llama3.2

# ============================================================================
# Gemini API Configuration (Cloud)
# ============================================================================

# Gemini API Key - Get from https://ai.google.dev
# Store GEMINI_API_KEY in Windows Credential Manager; see
# docs/cloud-provider-security.md. Do not put credentials in this template.

# Gemini Model Name
MICA_GEMINI_MODEL=gemini-2.5-flash

# Alternative: GOOGLE_API_KEY (also accepted)
# GOOGLE_API_KEY is accepted as an alternative and takes precedence.

# ============================================================================
# OpenAI API Configuration (Cloud)
# ============================================================================

# OpenAI API Key - Get from https://platform.openai.com
# Store OPENAI_API_KEY in Windows Credential Manager.

# OpenAI Model Name
MICA_OPENAI_MODEL=gpt-4.1-mini

# ============================================================================
# Assistant Configuration
# ============================================================================

# The active assistant persona is configured through the local MICA profile.

# Personal profile fields are managed through the desktop settings.

# ============================================================================
# Advanced Agent Configuration
# ============================================================================

# Allowed roots are separated by the OS path separator (semicolon on Windows).
# Native actions remain disabled until exact allowed roots and actions are set.
MICA_WINDOWS_ALLOWED_ROOTS=
MICA_WINDOWS_ENABLED_ACTIONS=

# Paid calls are bounded by the backend operation ledger.

# ============================================================================
# Optional: Cloud Settings
# ============================================================================

# Allow private context data to be sent to cloud LLMs
# Set to "true" or "1" to enable (default: false)
MICA_CLOUD_ALLOW_PRIVATE_CONTEXT=false

# ============================================================================
# Optional: Development Settings
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================
# - API keys are sensitive - never commit .env to version control
# - Use .env.example as a template for new installations
# - Local LLM (Ollama) is recommended for privacy and cost
# - Cloud LLMs provide advanced features but require API keys
# - Configure allowed native action roots before enabling actions
