# Copy this file to .env on the ZimaOS host or inside the Proxmox Linux VM.
# Paths are local to that Docker host and mounted by Compose.
MICA_DATA_DIR=/DATA/AppData/mica
## LAN name served by the included Caddy proxy. Trust Caddy's local CA on
## every PC/phone that opens the PWA, or replace `tls internal` with your own
## LAN certificate policy.
MICA_PUBLIC_HOST=mica.local
MICA_ALLOWED_VOICE_ORIGINS=https://mica.local
# Required for browser-bound confirmations. Use a long random local secret;
# it is kept in the host environment and never written to Brain or audit.
MICA_APPROVAL_SECRET=replace-with-a-long-random-local-secret
MICA_HTTP_PORT=80
MICA_HTTPS_PORT=443
LLAMA_MODEL=Qwen3-4B-Q4_K_M.gguf
# Local by default. To opt into a cloud provider, set this to `openai_api` or
# `gemini`; provide the key through Windows Credential Manager, not this file.
MICA_LLM_PROVIDER=ollama
# Phase 2 is fail-closed. Enable manual research only after reviewing the
# domain source allowlists in /data/learning/domains.json.
MICA_LEARNING_NETWORK=0
# Keep monitoring off until manual research has passed its daily-use gate.
MICA_LEARNING_MONITORING_ENABLED=0
# Phase 3A remains an explicit local pilot. Tasks require the first flag;
# automatic rule execution additionally requires the second flag.
MICA_PHASE3_ENABLED=0
MICA_AUTOMATIONS_ENABLED=0
# Phase 4 remains a local pilot. Master and feature flags are fail-closed.
MICA_PHASE4_ENABLED=0
MICA_SELF_PLANNING_ENABLED=0
MICA_SERVER_AGENT_ENABLED=0
MICA_DIGITAL_TWIN_ENABLED=0
MICA_SELF_IMPROVEMENT_ENABLED=0
# Exact local ZimaOS identifiers only; no user-supplied hosts or URLs.
MICA_SERVER_AGENT_TARGETS=zimaos-local
# MICA_OPENAI_MODEL=gpt-4.1-mini
# MICA_GEMINI_MODEL=gemini-2.5-flash
# Separate opt-in required before local Brain/profile context is sent to cloud.
# MICA_CLOUD_ALLOW_PRIVATE_CONTEXT=0
# Optional local-only fallback, enabled with: docker compose --profile fallback …
# LLAMA_FALLBACK_MODEL=Qwen3-1.7B-Q4_K_M.gguf
# MICA_LLM_FALLBACK_URL=http://llama-fallback:8080
WHISPER_MODEL=ggml-small.bin
# Automatic voice policy: Gemini uses Gemini TTS, OpenAI API uses OpenAI TTS,
# and local providers use Kokoro. Cloud voices send the reply text to the
# selected provider and can incur network costs. Explicit overrides remain.
MICA_TTS_ENGINE=auto
MICA_OPENAI_TTS_MODEL=gpt-4o-mini-tts
MICA_OPENAI_TTS_VOICE=coral
MICA_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
MICA_GEMINI_TTS_VOICE=Sulafat
KOKORO_MODEL=kokoro/kokoro-v1_0.pth
KOKORO_CONFIG=kokoro/config.json
KOKORO_VOICE=kokoro/voices/df_kerstin.pt
PIPER_MODEL=dii_de-DE.onnx
# Conservative starting point for a GTX 970. Tune only after the preflight load test.
LLAMA_GPU_LAYERS=12
# Leave disabled unless the separately deployed host agent has mTLS client
# material in ${MICA_DATA_DIR}/host-agent-client (ca.crt, client.crt, client.key).
MICA_HOST_AGENT_URL=
# When using the HTTPS reverse proxy, this must be its exact public origin.
# MICA_ALLOWED_VOICE_ORIGINS=https://mica.example.lan
# Optional, explicitly mounted legacy JSON file (for one-time migration only).
# LEGACY_MEMORY_PATH=/data/import/long_term.json
# Opt-in connector endpoints. Keep tokens/credentials in the host environment
# or a secret manager; they are never written to MICA Markdown or SQLite.
# MICA_TELEGRAM_BOT_TOKEN=
# MICA_TELEGRAM_CHAT_ID=
# MICA_TELEGRAM_WEBHOOK_SECRET=
# Optional allowlist for inbound Telegram chat IDs; leave unset only when the
# randomly generated webhook secret is the intended sole inbound gate.
# MICA_TELEGRAM_INBOUND_CHAT_IDS=
# MICA_WHATSAPP_ACCESS_TOKEN=
# MICA_WHATSAPP_PHONE_NUMBER_ID=
# MICA_WHATSAPP_VERIFY_TOKEN=
# MICA_WHATSAPP_APP_SECRET=
# MICA_CONNECTOR_WEBHOOK_MAX_BYTES=262144
# MICA_PUSH_URL=https://ntfy.example.lan
# MICA_PUSH_TOPIC=mica
# MICA_PUSH_TOKEN=
# MICA_PUSH_WEBHOOK_SECRET=
# MICA_SIP_ARI_URL=https://asterisk.example.lan:8089/ari
# MICA_SIP_ARI_USER=
# MICA_SIP_ARI_PASSWORD=
# MICA_SIP_ALLOWED_DESTINATIONS=SIP/100,SIP/101
# MICA_SIP_WEBHOOK_SECRET=
